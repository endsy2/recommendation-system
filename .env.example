# Copy to .env (git-ignored) and adjust. Real environment variables take precedence over .env.
# Local Milvus Standalone started with deploy/milvus/docker-compose.yml (listens on localhost only).
MILVUS_URI=http://localhost:19530
# Leave empty for the default local server (authentication disabled). For an authenticated server
# use "username:password" or an API key. Never commit a real token.
MILVUS_TOKEN=
# Completed collection the web app serves: songs_sample (1,000-song dev sample) or songs_full.
MILVUS_COLLECTION=songs_sample
# Per-request timeout in seconds (0 < value <= 300).
MILVUS_TIMEOUT=10
# Optional SentenceTransformer device, e.g. cpu or cuda. Empty = library default.
SONG_SEARCH_DEVICE=
